# Copy this file to .env and fill in real values. NEVER commit .env.
APP_NAME=PGPC SmartGuide
DEBUG=true
# SQLite file, created automatically in the project folder. Relative paths are relative to the project folder.
DATABASE_URL=sqlite:///./pgpc_smartguide.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
OPENAI_API_KEY=
LLM_MODEL=
SIMILARITY_THRESHOLD=0.35
HIGH_CONFIDENCE_THRESHOLD=0.80
MEDIUM_CONFIDENCE_THRESHOLD=0.60
SESSION_EXPIRE_MINUTES=60
MAX_SESSION_MESSAGES=100
FOLLOWUP_WINDOW=10
CHAT_RETENTION_DAYS=30
MAX_UPLOAD_SIZE_MB=10

# First admin account (used by: python -m app.database.create_admin).
# Choose a strong password, run the command once, then remove ADMIN_PASSWORD from .env.
ADMIN_USERNAME=admin
ADMIN_EMAIL="kptugna21@gmail.com"
ADMIN_PASSWORD="admin1234"

# Text mining
MAX_QUESTION_CHARS=500
SPELLING_CUTOFF=0.85

# Intent classifier: below this confidence the chatbot treats the intent as "unknown"
INTENT_MIN_CONFIDENCE=0.35
